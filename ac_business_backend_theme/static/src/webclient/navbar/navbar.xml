<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ac_business_backend_theme.NavBar"
       t-inherit="web.NavBar"
       t-inherit-mode="extension"
       owl="1">

        <xpath expr="//nav" position="before">
            <t t-set="apps" t-value="menuService.getApps()" />
        </xpath>

        <xpath expr="//t[@t-call='web.NavBar.AppsMenu']" position="replace">

            <AppsMenu
                hotkey="'h'"
                title="'Home Menu'"
                class="o_navbar_apps_menu"
                manualOnly="true"
            >
                <t t-set-slot="toggler">
                    <i class="fa fa-th" aria-hidden="true"/>
                </t>

                <div class="ac-apps-header">
                    <img
                        class="ac-apps-logo"
                        t-att-src="companyLogoUrl"
                        t-att-alt="companyName"
                    />
                    <p class="ac-apps-tagline" t-esc="companyName"/>
                </div>

                <div class="ac-apps-floaters" aria-hidden="true">
                    <span>📊</span>
                    <span>💼</span>
                    <span>📈</span>
                    <span>🧾</span>
                    <span>💰</span>
                    <span>📁</span>
                </div>

                <div class="ac-apps-grid">
                    <MenuItem
                        t-foreach="apps"
                        t-as="app"
                        t-key="app.id"
                        class="o_app"
                        t-att-class="{ focus: menuService.getCurrentApp() === app }"
                        payload="app"
                    >
                        <a t-att-href="getMenuItemHref(app)" t-on-click.prevent="">
                            <div class="ac-app-icon-wrap">
                                <img
                                    t-if="app.webIconData"
                                    class="ac-app-icon"
                                    t-attf-src="data:image/png;base64,{{ app.webIconData }}"
                                />
                                <img
                                    t-else=""
                                    class="ac-app-icon"
                                    t-att-src="companyLogoUrl"
                                    t-att-alt="companyName"
                                />
                            </div>
                            <span class="ac-app-name">
                                <t t-esc="app.name"/>
                            </span>
                        </a>
                    </MenuItem>
                </div>

                <div class="ac-apps-ticker-wrap">
                    <div class="ac-apps-ticker">
                        <span>📊 Ledgers Balanced</span>
                        <span>💼 Receivables Current</span>
                        <span>📈 Financial Clarity</span>
                        <span>🧾 Compliant Reporting</span>
                        <span>💰 Cashflow Insights</span>
                        <span>📁 Secure Records</span>
                        <span>📊 Ledgers Balanced</span>
                        <span>💼 Receivables Current</span>
                        <span>📈 Financial Clarity</span>
                        <span>🧾 Compliant Reporting</span>
                        <span>💰 Cashflow Insights</span>
                        <span>📁 Secure Records</span>
                    </div>
                </div>

            </AppsMenu>

            <a class="ac-navbar-logo" href="/web" t-att-title="companyName or 'Home'">
                <img
                    t-att-src="companyLogoUrl"
                    t-att-alt="companyName"
                    class="ac-navbar-logo-img"
                />
            </a>

        </xpath>

        <xpath expr="//t[@t-call='web.NavBar.SectionsMenu']" position="attributes">
            <attribute name="t-if">currentAppSections.length</attribute>
        </xpath>

        <xpath expr="//nav" position="inside">
            <AppsBar
                apps="apps"
                currentApp="menuService.getCurrentApp()"
                companyName="companyName"
                companyLogoUrl="companyLogoUrl"
            />
        </xpath>

    </t>

</templates>
