<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_ac_payment_receipt_landscape" model="report.paperformat">
        <field name="name">Payment Receipt A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_ac_payment_receipt" model="ir.actions.report">
        <field name="name">Payment Receipt</field>
        <field name="model">ac.customer.job.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ac_customer_receivable.report_ac_payment_receipt</field>
        <field name="report_file">ac_customer_receivable.report_ac_payment_receipt</field>
        <field name="print_report_name">'Payment Receipt - %s' % (object.name or object.id)</field>
        <field name="paperformat_id" ref="paperformat_ac_payment_receipt_landscape"/>
        <field name="binding_model_id" ref="model_ac_customer_job_payment"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
