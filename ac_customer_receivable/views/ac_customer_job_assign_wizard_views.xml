<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ac_customer_job_assign_wizard_view_form" model="ir.ui.view">
        <field name="name">ac.customer.job.assign.wizard.form</field>
        <field name="model">ac.customer.job.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign To">
                <group>
                    <field name="job_id" invisible="1"/>
                    <field name="assigned_user_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_assign" string="Assign" type="object" class="btn-primary"
                            confirm="Are you sure you want to assign this service engagement to the selected user?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
