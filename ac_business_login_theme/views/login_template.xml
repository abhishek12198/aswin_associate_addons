<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
  AC Business Login Theme
  Palette synced with ac_business_backend_theme:
    navy #0c1f4d / #102a63 / #1a3a8a, blue #2b59c3, white surfaces
-->
<template id="login" name="AC Business Login">
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <meta name="theme-color" content="#102a63"/>
  <title t-esc="(company_name or 'Company') + ' — Sign In'"/>
  <link rel="icon" t-att-href="favicon_url or '/web/binary/company_logo'" type="image/png"/>
  <link rel="shortcut icon" t-att-href="favicon_url or '/web/binary/company_logo'" type="image/png"/>
  <link rel="preload" as="image" href="/web/binary/company_logo"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    html { background: #102a63; color-scheme: dark; }

    body {
      min-height: 100vh;
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background:
        radial-gradient(ellipse 70% 50% at 10% 0%, rgba(255,255,255,0.10) 0%, transparent 60%),
        radial-gradient(ellipse 70% 50% at 90% 0%, rgba(74,122,224,0.28) 0%, transparent 60%),
        linear-gradient(160deg, #0c1f4d 0%, #102a63 45%, #1a3a8a 100%);
      display: flex;
      align-items: stretch;
      justify-content: center;
      overflow-x: hidden;
      position: relative;
    }

    /* Soft grid for a finance-tool feel */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
      background-size: 48px 48px;
      pointer-events: none;
      z-index: 0;
    }

    .ac-shell {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 1080px;
      margin: auto;
      padding: 24px;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 28px;
      align-items: center;
    }

    /* ── Brand panel ─────────────────────────────────────────────── */
    .ac-brand {
      color: #fff;
      padding: 24px 12px 24px 8px;
    }
    .ac-brand-logo {
      width: 72px;
      height: 72px;
      border-radius: 16px;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25);
      margin-bottom: 22px;
    }
    .ac-brand-logo img {
      width: 78%;
      height: 78%;
      object-fit: contain;
    }
    .ac-brand h1 {
      font-size: clamp(1.6rem, 2.4vw, 2.2rem);
      font-weight: 750;
      letter-spacing: -0.02em;
      line-height: 1.2;
      margin-bottom: 12px;
      max-width: 16ch;
    }
    .ac-brand p {
      font-size: 1rem;
      line-height: 1.55;
      color: rgba(255,255,255,0.78);
      max-width: 34ch;
      margin-bottom: 28px;
    }
    .ac-points {
      list-style: none;
      display: grid;
      gap: 10px;
    }
    .ac-points li {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.92rem;
      font-weight: 600;
      color: rgba(255,255,255,0.88);
    }
    .ac-points li::before {
      content: '';
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #4a7ae0;
      box-shadow: 0 0 0 4px rgba(74,122,224,0.22);
      flex-shrink: 0;
    }

    /* ── Login card ──────────────────────────────────────────────── */
    .ac-card {
      background: #ffffff;
      border-radius: 16px;
      padding: 36px 34px 30px;
      box-shadow:
        0 1px 0 rgba(255,255,255,0.35) inset,
        0 24px 60px rgba(12,31,77,0.35);
      animation: acCardIn .35s ease both;
    }
    @keyframes acCardIn {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .ac-card-header {
      margin-bottom: 22px;
    }
    .ac-card-header h2 {
      font-size: 1.35rem;
      font-weight: 750;
      color: #0c1f4d;
      letter-spacing: -0.01em;
      margin-bottom: 4px;
    }
    .ac-card-header p {
      font-size: 0.9rem;
      color: #64748b;
    }

    .ac-alert {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 10px;
      padding: 12px 14px;
      margin-bottom: 16px;
      color: #b91c1c;
      font-size: 0.88rem;
      font-weight: 600;
    }

    .ac-field { margin-bottom: 14px; }
    .ac-field label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #334155;
      margin-bottom: 6px;
    }
    .ac-input {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #d0d7e6;
      border-radius: 10px;
      background: #f8fafc;
      color: #0c1f4d;
      font-size: 0.95rem;
      font-weight: 500;
      outline: none;
      transition: border-color .15s, box-shadow .15s, background .15s;
    }
    .ac-input::placeholder { color: #94a3b8; }
    .ac-input:focus {
      border-color: #2b59c3;
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(43,89,195,0.18);
    }

    .ac-btn {
      display: block;
      width: 100%;
      margin-top: 18px;
      padding: 13px 18px;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: #ffffff;
      background: linear-gradient(135deg, #2b59c3 0%, #1a3a8a 100%);
      box-shadow: 0 8px 20px rgba(43,89,195,0.35);
      transition: transform .12s, box-shadow .12s, filter .12s;
    }
    .ac-btn:hover {
      transform: translateY(-1px);
      filter: brightness(1.05);
      box-shadow: 0 10px 24px rgba(43,89,195,0.42);
    }
    .ac-btn:active { transform: translateY(0); }

    .ac-card-foot {
      margin-top: 18px;
      text-align: center;
      font-size: 0.78rem;
      color: #94a3b8;
    }

    /* ── Overlays ────────────────────────────────────────────────── */
    #ac-loader,
    #ac-logout-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 99999;
      background: linear-gradient(160deg, #0c1f4d 0%, #102a63 50%, #1a3a8a 100%);
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }
    #ac-loader.ac-visible,
    #ac-logout-overlay.ac-visible { display: flex; }
    #ac-logout-overlay.ac-fade-out {
      opacity: 0;
      transition: opacity .35s ease;
      pointer-events: none;
    }

    .ac-spin {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      border: 3px solid rgba(255,255,255,0.15);
      border-top-color: #ffffff;
      animation: acSpin .7s linear infinite;
      margin-bottom: 8px;
    }
    @keyframes acSpin { to { transform: rotate(360deg); } }

    .ac-overlay-logo {
      width: 56px;
      height: 56px;
      border-radius: 14px;
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      margin-bottom: 6px;
    }
    .ac-overlay-logo img {
      width: 70%;
      height: 70%;
      object-fit: contain;
    }
    .ac-overlay-title {
      color: #fff;
      font-size: 1.05rem;
      font-weight: 700;
    }
    .ac-overlay-sub {
      color: rgba(255,255,255,0.7);
      font-size: 0.88rem;
      font-weight: 500;
    }
    .ac-logout-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 10px;
      padding: 7px 14px;
      border-radius: 999px;
      background: rgba(16,185,129,0.14);
      border: 1px solid rgba(16,185,129,0.4);
      color: #6ee7b7;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .ac-logout-badge i {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #34d399;
      display: inline-block;
    }

    /* ── Responsive ──────────────────────────────────────────────── */
    @media (max-width: 860px) {
      .ac-shell {
        grid-template-columns: 1fr;
        max-width: 460px;
        padding: 18px;
      }
      .ac-brand {
        text-align: center;
        padding: 8px 4px 0;
      }
      .ac-brand-logo { margin-left: auto; margin-right: auto; }
      .ac-brand h1 { max-width: none; }
      .ac-brand p { max-width: none; margin-left: auto; margin-right: auto; }
      .ac-points { justify-items: center; }
      .ac-points li { justify-content: center; }
    }

    @media (max-width: 480px) {
      .ac-card { padding: 28px 20px 22px; border-radius: 14px; }
      .ac-brand h1 { font-size: 1.45rem; }
      body::before { background-size: 36px 36px; }
    }

    @media (min-width: 1600px) {
      .ac-shell { max-width: 1180px; }
      .ac-card { padding: 42px 40px 34px; }
      .ac-brand h1 { font-size: 2.35rem; }
    }
  </style>
</head>
<body>
  <div class="ac-shell">

    <section class="ac-brand">
      <div class="ac-brand-logo">
        <img t-att-src="company_logo_url or '/web/binary/company_logo'"
             t-att-alt="company_name or 'Company'"/>
      </div>
      <h1 t-esc="company_name or 'Company'"/>
      <p>Secure access to your accounting workspace, receivables, and financial records.</p>
      <ul class="ac-points">
        <li>Clear financial oversight</li>
        <li>Protected business data</li>
        <li>Built for day-to-day accounting</li>
      </ul>
    </section>

    <section class="ac-card">
      <div class="ac-card-header">
        <h2>Sign in</h2>
        <p>Enter your credentials to continue</p>
      </div>

      <t t-if="error">
        <div class="ac-alert">
          <span>⚠</span>
          <span t-esc="error"/>
        </div>
      </t>

      <form method="post" action="/web/login">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <t t-if="redirect">
          <input type="hidden" name="redirect" t-att-value="redirect"/>
        </t>

        <div class="ac-field">
          <label for="ac_login">Email / Username</label>
          <input id="ac_login"
                 class="ac-input"
                 type="text"
                 name="login"
                 t-att-value="login"
                 placeholder="name@company.com"
                 autocomplete="username"
                 autofocus="autofocus"
                 required="required"/>
        </div>

        <div class="ac-field">
          <label for="ac_password">Password</label>
          <input id="ac_password"
                 class="ac-input"
                 type="password"
                 name="password"
                 placeholder="Enter your password"
                 autocomplete="current-password"
                 required="required"/>
        </div>

        <button type="submit" class="ac-btn">Sign In</button>
      </form>

      <div class="ac-card-foot">
        Authorized users only · Encrypted session
      </div>
    </section>
  </div>

  <div id="ac-loader">
    <div class="ac-overlay-logo">
      <img t-att-src="company_logo_url or '/web/binary/company_logo'"
           t-att-alt="company_name or 'Company'"/>
    </div>
    <div class="ac-spin"></div>
    <div class="ac-overlay-title" t-esc="company_name or 'Company'"/>
    <div class="ac-overlay-sub">Signing you in...</div>
  </div>

  <div id="ac-logout-overlay">
    <div class="ac-logout-badge"><i></i> Signed out</div>
    <div class="ac-overlay-logo">
      <img t-att-src="company_logo_url or '/web/binary/company_logo'"
           t-att-alt="company_name or 'Company'"/>
    </div>
    <div class="ac-spin"></div>
    <div class="ac-overlay-title" t-esc="company_name or 'Company'"/>
    <div class="ac-overlay-sub">Returning to sign in...</div>
  </div>

  <script>
    (function () {
      var form = document.querySelector('form');
      if (form) {
        form.addEventListener('submit', function () {
          document.getElementById('ac-loader').classList.add('ac-visible');
        });
      }
    })();

    (function () {
      if (window.location.search.indexOf('logged_out=1') === -1) return;
      if (window.history &amp;&amp; window.history.replaceState) {
        window.history.replaceState(null, '', '/web/login');
      }
      var overlay = document.getElementById('ac-logout-overlay');
      overlay.classList.add('ac-visible');
      setTimeout(function () {
        overlay.classList.add('ac-fade-out');
        setTimeout(function () {
          overlay.classList.remove('ac-visible');
          overlay.classList.remove('ac-fade-out');
        }, 360);
      }, 1400);
    })();
  </script>
</body>
</html>
</template>

</odoo>
